flowchart LR
  %% [HOLD:INTERNAL-DIAGRAM] Docking review source. Buyer use requires claim review.
  faceplane[Face Plane<br/>UI / Entry]
  xe[Execution Evaluation<br/>Validation Layer]
  gaas[Governance Alignment Service<br/>Policy Mapping]
  docking[Docking<br/>API + RBAC Boundary]
  decision{Allowed?}
  register[Allowed to Register]
  approval[Needs Approval]
  restricted[Blocked]

  faceplane --> xe
  xe --> gaas
  gaas --> docking
  docking --> decision
  decision -- yes --> register
  decision -- needs human --> approval
  decision -- no --> restricted
