# Receipt Ledger Backend Configuration

# Backend selection: 'memory', 'file', or 'postgres'
# Defaults to 'memory' (in-memory store for testing)
RECEIPT_LEDGER_BACKEND=memory

# For file backend: directory where receipts.jsonl is stored
# Defaults to '.data'
RECEIPT_LEDGER_DATA_DIR=.data

# For PostgreSQL backend: connection string
# Example: postgresql://user:password@localhost:5432/executive_desk
DATABASE_URL=

# Server Configuration
PORT=3000
NODE_ENV=development

# Authentication (optional for v1, required for production)
# Bearer token validation
AUTH_ENABLED=false
JWT_SECRET=your-secret-key-here

# CORS Configuration
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
