    "check:ten-001": "node scripts/check-tenant-isolation.js",
    "check:per-001": "PER001_REPORT_PATH=docs/executive-desk/evidence/per-001-performance-slo.json node scripts/check-performance-slo.js",
    "check:rec-001": "REC001_REPORT_PATH=docs/executive-desk/evidence/rec-001-recovery-resilience.json node scripts/check-recovery-resilience.js",
    "check:xe-target-packet": "node scripts/check-xe-target-packet.js",
    "check:xe-execute": "node scripts/check-xe-execute.js",
    "check:gates": "node scripts/run-executive-gates.js",
    "check:gates:strict-auth": "GATE_SEC_001_STRICT=true node scripts/run-executive-gates.js",
    "check:executive-desk:api": "mocha --require tsx apps/executive-desk/api/__tests__/routes.test.ts",
    "check:executive-desk:proxy": "tsx apps/executive-desk/proxy/test-handler.ts",
    "check:executive-desk:frontend": "node scripts/check-executive-desk-frontend.js",
    "check:executive-desk:e2e": "node scripts/check-executive-desk-e2e-demo.js",
    "check:executive-desk:types": "tsc --noEmit --skipLibCheck --module esnext --target es2022 --moduleResolution bundler --esModuleInterop --types mocha,node apps/executive-desk/server.ts apps/executive-desk/api/express-adapter.ts apps/executive-desk/api/receipt-queries.ts apps/executive-desk/api/delegation-queries.ts apps/executive-desk/api/risk-api.ts apps/executive-desk/api/__tests__/routes.test.ts apps/executive-desk/proxy/command-handler.ts apps/executive-desk/proxy/test-handler.ts",
    "test": "mocha --require tsx \"apps/executive-desk/**/__tests__/**/*.test.ts\" \"apps/executive-desk/**/*.test.ts\" \"apps/sentinel/**/__tests__/**/*.test.js\" \"apps/sentinel/**/*.test.js\"",
    "test:coverage": "c8 --all --src apps/executive-desk --exclude \"apps/executive-desk/public/**\" --exclude \"apps/executive-desk/**/__tests__/**\" --exclude \"apps/executive-desk/**/*.test.ts\" --exclude \"apps/executive-desk/**/*.md\" --reporter=text-summary --reporter=lcov pnpm run test",
    "test:coverage:check": "c8 check-coverage --lines 80 --statements 80 --functions 80 --branches 75",
    "check:policy": "node scripts/check-policy-engine.js",
    "check:product-commands": "node scripts/check-product-command-routing.js",
    "check:receipts": "node scripts/check-receipt-lookup.js",
    "check:state-anchors": "node scripts/check-state-anchors.js",
    "check:archive-intelligence": "node scripts/check-archive-intelligence-docking.js",
    "check:stripe-checkout": "node scripts/check-stripe-checkout-ingestion.js",
    "check:revenue-readiness": "node scripts/check-revenue-readiness-held.js",
    "check:light-quant-nextsteps": "node scripts/check-light-quantitative-nextsteps.js",
    "check:bridge-gaps-report": "node scripts/check-bridge-gaps-report.js",
    "check:task-templates": "node scripts/check-task-templates.js",
    "check:telemetry-harmonizer": "node scripts/check-telemetry-harmonizer.js",
    "check:trust-score": "node scripts/check-trust-score.js",
    "check:tiers": "node scripts/check-tier-registry.js",
    "check:sovereign-license": "node scripts/check-sovereign-license.js",
    "generate:sovereign-keypair": "node scripts/generate-sovereign-keypair.js",
    "generate:sovereign-license": "node scripts/generate-sovereign-license.js",
    "check:ready": "node scripts/check-ready-endpoint.js",
    "check:vendor-ledger": "node scripts/check-vendor-onboarding-ledger.js",
    "check:vendor-onboarding": "node scripts/check-vendor-onboarding-rules.js",
    "governance:heartbeat": "node scripts/write-governance-heartbeat.js",
    "repo:scan": "node scripts/sentinel-repo-organization-scan.js",
    "check:repo-control": "node scripts/check-repo-control-layer.js",
    "check:asset-classification": "node scripts/classify-sentinel-assets.js",
    "check:ownerfi-ai-financial-manifest": "node scripts/verify-manifest-checksums.js",
    "check:white-glove-support-request": "node scripts/check-white-glove-support-request.js",
    "generate:executive-calendar": "node scripts/generate-execution-calendar.js",
    "release:anchor": "node scripts/generate-system-release-anchor.js",
    "posture:containment": "node scripts/check-containment-posture.js",
    "simulate:vendor-onboarding": "node scripts/simulate-vendor-onboarding.js",
    "simulate:mock-faceplanes": "node scripts/run-mock-faceplanes.js",
    "simulate:stress-mock-faceplanes": "node scripts/stress-mock-faceplanes.js",
    "db:apply-schema": "node scripts/db-apply-schema.js",
    "db:smoke": "node scripts/db-smoke.js",
    "verify:executive-desk:fast": "node scripts/sentinel-ai-package.js --fast",
    "verify:executive-desk:full": "node scripts/sentinel-ai-package.js",
    "sentinel:package": "pnpm run verify:executive-desk:full"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.1.0",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.0",
    "c8": "^11.0.0",
    "mocha": "^11.7.6",
    "supertest": "^7.2.2",
    "tsx": "^4.22.5",
    "typescript": "^6.0.3"
  }
