    "check:cdnlux": "node scripts/check-cdnlux-integration.js",
    "check:control-plane": "node scripts/check-control-plane.js",
    "check:customerops": "node scripts/check-customerops-command-routing.js",
    "check:control-ui": "node scripts/check-control-ui.js",
    "check:control-ui-route": "node scripts/check-control-ui-route.js",
    "check:docking": "node scripts/check-docking-protocol.js",
    "check:proof-ui-flow": "node scripts/check-proof-ui-flow.js",
    "check:approvals": "node scripts/check-approval-access.js",
    "check:idempotency": "node scripts/check-idempotency.js",
    "check:sentinel-nexus-bhindi-vault-read-only-poc": "node scripts/check-sentinel-nexus-bhindi-vault-read-only-poc.js",
    "check:execution-trace-completeness": "node scripts/check-execution-trace-completeness.js",
    "check:keys": "node scripts/check-key-registry.js",
    "check:governance-drift": "node scripts/check-governance-drift-monitor.js",
    "check:governance-drift-core": "node scripts/check-drift-governance-core.js",
