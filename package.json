    "check:ownerfi-proof-health": "node scripts/check-ownerfi-proof-health-receipt.js",
    "check:sec-001": "SEC001_REPORT_PATH=docs/executive-desk/evidence/sec-001-auth-enforcement.json node scripts/check-hosted-auth-enforcement.js",
