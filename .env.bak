PORT=3000

SENTINEL_API_KEY=48f1c6a241b184c10770060ac4a9bd5603b37ea8ddd3e684cc7ac599f61e3677
SENTINEL_HMAC_SECRET=d31ce60f6af89ce36b97ac61d7f6aa6e9889c4b1b0764a5fc0fbc4fd10a04784e97426479ff1974bdb1ff4aee1e28d67579224f4bb62c36b6d1215a32e1dae72
DATABASE_URL=postgres://user:password@host:5432/sentinelos
NODE_ENV=production

# Deployment tier classification
# Options: PUBLIC | ENTERPRISE | GOVERNMENT | SOVEREIGN
# Leave unset to default to PUBLIC
SENTINEL_DEPLOYMENT_TIER=PUBLIC

# Sovereign mode
# Set to 1 to require a valid sovereign license file at startup
SENTINEL_SOVEREIGN_MODE=0
SENTINEL_LICENSE_FILE=./sentinel.license.json
SENTINEL_LICENSE_KEY=replace-with-license-verification-key
SENTINEL_LICENSE_SIGNING_KEY=replace-with-your-private-signing-key
SENTINEL_DEPLOYMENT_TIER=PUBLIC
SENTINEL_SOVEREIGN_MODE=0
SENTINEL_GOV_MODE=0
SENTINEL_STRIPE_CHECKOUT_ENABLED=0

# Key tenant configuration - override default ownerfi tenant
SENTINEL_API_KEY_TENANT=sentinelos
SENTINEL_API_KEY_ACTOR=sentinel.admin@sentinelos.local
SENTINEL_API_KEY_ROLE=admin
SENTINEL_API_KEY_SCOPES=platform:admin,tenant:admin,task:orchestrate,task:execute,task:read,learning:read,learning:write,audit:read,openai:execute,openai:read
